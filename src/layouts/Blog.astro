---
import Base from './Base.astro';
import Footer from '../components/Footer.jsx';
---
<Base {...Astro.props}>
  <header class="bg-white shadow-sm">
    <div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
      <a href="/" class="w-8 h-8"><img src="/Felix-Apple-round.png" alt="Home" /></a>
      <a href="/blog/" class="text-gray-700 hover:text-gray-900">Blog</a>
    </div>
  </header>
  <main class="max-w-3xl mx-auto px-4 py-12 min-h-screen">
    <slot />
  </main>
  {/* shortcut: blog chrome is English-only; posts are single-language anyway. Wire up the lang toggle here if you write bilingual posts. */}
  <Footer t={(en) => en} />
</Base>
