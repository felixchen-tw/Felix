---
import { getCollection, render } from 'astro:content';
import Blog from '../../layouts/Blog.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Blog title={`${post.data.title} — Felix`} description={post.data.description}>
  <a href="/blog/" class="text-sm text-gray-500 hover:text-gray-900">← Blog</a>
  <h1 class="text-3xl font-bold text-gray-900 mt-4">{post.data.title}</h1>
  <p class="text-sm text-gray-500 mb-8">{post.data.date.toISOString().slice(0, 10)}</p>
  <article class="post"><Content /></article>
</Blog>
